# Öffentliche Adresse, so wie sie im Browser steht (Subdomain frei wählbar).
PUBLIC_URL=https://projekte.example.org

# Signiert die Anmelde-Cookies. Langer Zufallswert: openssl rand -base64 32
# Ändern meldet alle ab.
SESSION_KEY=

# Optional: Schlüssel für die persönlichen Kunden-Links (sonst aus SESSION_KEY abgeleitet).
# LINK_KEY=

# Passwort der Datenbank (nur im Compose-Netz erreichbar): openssl rand -base64 24
POSTGRES_PASSWORD=

# Erster Admin – wird nur beim allerersten Start angelegt, solange es noch keinen Benutzer gibt.
# Beim ersten Login muss das Passwort geändert werden; danach können die Zeilen weg.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Sprache für neue Projekte und die Anmeldeseite: de oder en
DEFAULT_LANGUAGE=de

# Hinter einem Reverse Proxy (z. B. Nginx Proxy Manager) auf true, damit die echte
# Absender-Adresse für die Login-Bremse zählt.
TRUSTED_PROXY=true

# Nur für die lokale Entwicklung (in compose.yml schon gesetzt):
# DATABASE_URL=postgres://postgres@127.0.0.1:5432/spm
# PORT=43871
